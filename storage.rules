rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Payment screenshots: uploaded by users during booking submission, viewable by owner & admin
    match /payment-screenshots/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && (request.auth.uid == userId || request.resource.size < 10 * 1024 * 1024);
    }

    // Chat images: attached in support or paid chat threads
    match /chat-images/{bookingId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Fallback rule for any media uploads by authenticated users
    match /{allPaths=**} {
      allow read, write: if isSignedIn();
    }
  }
}
